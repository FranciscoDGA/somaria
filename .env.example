# ---------------------------------------------------------------------------
# Sobraria — variáveis de ambiente
# Copie para .env.local e preencha o que for usar. Nenhuma é obrigatória para
# rodar o projeto localmente: todos os recursos têm fallback.
# ---------------------------------------------------------------------------

# URL pública do site (usada em canonical, sitemap e OpenGraph).
NEXT_PUBLIC_SITE_URL=https://sobraria.com.br

# Google AdSense — ID do publisher (ca-pub-0000000000000000).
# Enquanto estiver vazio, o site mostra apenas placeholders discretos.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ID do bloco de anúncio criado no painel do AdSense (ex.: 1234567890).
# O anúncio só é renderizado com cliente + bloco + consentimento aceito.
NEXT_PUBLIC_ADSENSE_SLOT=

# Endpoint que recebe POST JSON { email, source } para a newsletter.
# Ex.: https://api.suaferramenta.com/newsletter
# Sem esta variável o formulário funciona em modo demonstração.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Endpoint opcional para o formulário de contato (POST JSON { name, email, message }).
# Sem ele, o envio abre o cliente de e-mail do visitante (mailto).
NEXT_PUBLIC_CONTACT_ENDPOINT=

# E-mail público exibido na página de contato e no fallback do formulário.
NEXT_PUBLIC_CONTACT_EMAIL=contato@sobraria.com.br
